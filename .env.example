# Copy to .env (git-ignored), fill in, then: chmod 600 .env
# Alpaca keys: https://app.alpaca.markets -> API keys. Signal Desk only reads (GET) with them,
# but Alpaca keys can trade, so treat them like a password and never paste them into chats.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# 1 = your live account (api.alpaca.markets). Anything else = paper (paper-api.alpaca.markets).
ALPACA_LIVE=0
# Phone alerts through ntfy.sh (optional). The topic works like a password.
NTFY_TOPIC=
# Extra host names the dashboard answers to, comma-separated (for a private network name such as Tailscale).
SIGNALDESK_HOSTS=
