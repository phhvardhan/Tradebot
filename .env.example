# Copy to .env (git-ignored), fill in, then: chmod 600 .env
# Alpaca keys: https://app.alpaca.markets -> API keys. Signal Desk syncs with them and places orders on the PAPER account only
# (never live, whatever ALPACA_LIVE says). Treat them like a password and never paste them into chats.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# 1 = your live account (api.alpaca.markets). Anything else = paper (paper-api.alpaca.markets).
ALPACA_LIVE=0
# Phone alerts through ntfy.sh (optional). The topic works like a password.
NTFY_TOPIC=
# Extra host names the dashboard answers to, comma-separated (for a private network name such as Tailscale).
SIGNALDESK_HOSTS=
# AI brain (optional): an OpenRouter key turns on the trade analyst and the strategy researcher. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from openrouter.ai/models; empty = anthropic/claude-opus-5.5.
OPENROUTER_MODEL=
